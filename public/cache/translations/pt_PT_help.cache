a:16:{s:4:"main";a:8:{s:5:"title";s:20:"Ajuda do Jogo (Wiki)";s:7:"welcome";s:105:"Bem-vindo à ajuda do jogo. Aqui encontrará informações sobre o jogo, suas mecânicas e estatísticas.";s:15:"buildings_title";s:10:"Edifícios";s:14:"buildings_desc";s:72:"Informações detalhadas sobre todos os edifícios, custos e requisitos.";s:11:"units_title";s:8:"Unidades";s:10:"units_desc";s:67:"Estatísticas de combate, velocidade e custos de todas as unidades.";s:14:"bb_codes_title";s:8:"BB-Codes";s:13:"bb_codes_desc";s:51:"Como formatar textos no fórum, mensagens e perfil.";}s:9:"buildings";a:4:{s:5:"title";s:10:"Edifícios";s:5:"intro";s:60:"Aqui encontra informações detalhadas sobre cada edifício.";s:5:"table";a:5:{s:8:"building";s:9:"Edifício";s:9:"max_level";s:14:"Nível Máximo";s:11:"description";s:11:"Descrição";s:5:"level";s:6:"Nível";s:6:"points";s:6:"Pontos";}s:9:"resources";a:4:{s:4:"wood";s:7:"Madeira";s:4:"clay";s:6:"Argila";s:4:"iron";s:5:"Ferro";s:10:"population";s:11:"População";}}s:5:"units";a:10:{s:5:"title";s:8:"Unidades";s:5:"intro";s:56:"Visão geral de todas as unidades disponíveis no mundo.";s:5:"table";a:4:{s:4:"unit";s:7:"Unidade";s:5:"speed";s:10:"Velocidade";s:5:"carry";s:5:"Carga";s:12:"recruited_in";s:12:"Recrutado em";}s:17:"minutes_per_field";s:17:"minutos por campo";s:5:"costs";s:6:"Custos";s:6:"combat";s:7:"Combate";s:6:"attack";s:6:"Ataque";s:15:"defense_general";s:12:"Defesa Geral";s:15:"defense_cavalry";s:16:"Defesa Cavalaria";s:15:"defense_archers";s:16:"Defesa Arqueiros";}s:8:"bb_codes";a:39:{s:6:"legend";s:7:"Legenda";s:4:"bold";s:7:"Negrito";s:6:"italic";s:8:"Itálico";s:9:"underline";s:9:"Sublinhar";s:13:"strikethrough";s:18:"Riscar sobre texto";s:5:"quote";s:5:"Citar";s:4:"link";s:22:"Colocar hiperligação";s:7:"spoiler";s:7:"Spoiler";s:6:"player";s:7:"Jogador";s:5:"tribe";s:5:"Tribo";s:11:"coordinates";s:11:"Coordenadas";s:6:"report";s:18:"Colocar relatório";s:9:"font_size";s:16:"Tamanho da Fonte";s:5:"image";s:14:"Colocar imagem";s:5:"color";s:20:"Colocar cor no texto";s:5:"codes";s:8:"Códigos";s:4:"code";s:7:"Código";s:5:"forum";s:6:"Fórum";s:7:"message";s:8:"Mensagem";s:7:"profile";s:6:"Perfil";s:5:"title";s:8:"BB-Codes";s:5:"intro";s:114:"BB-Codes são códigos especiais usados para formatar textos em mensagens, fóruns de tribo e perfis de jogadores.";s:12:"format_title";s:62:"Formatação de Texto (Negrito, Itálico, Sublinhado, Tachado)";s:11:"color_title";s:13:"Cores (Color)";s:10:"size_title";s:23:"Tamanho da Fonte (Size)";s:11:"quote_title";s:17:"Citação (Quote)";s:10:"link_title";s:11:"Links / URL";s:14:"entities_title";s:18:"Jogadores e Tribos";s:12:"coords_title";s:22:"Coordenadas (Map Link)";s:13:"spoiler_title";s:7:"Spoiler";s:9:"img_title";s:15:"Imagens (Image)";s:12:"report_title";s:11:"Relatórios";s:14:"building_title";s:21:"Edifícios (Building)";s:10:"unit_title";s:15:"Unidades (Unit)";s:11:"table_title";s:15:"Tabelas (Table)";s:12:"how_it_looks";s:10:"Como Fica:";s:13:"building_desc";s:49:"Mostra o ícone gráfico de um edifício do jogo.";s:9:"unit_desc";s:57:"Mostra o ícone gráfico de uma unidade de tropa do jogo.";s:10:"table_desc";s:117:"Permite criar tabelas formatadas. Suporta tanto tags HTML padrão quanto a sintaxe simplificada de colchetes do jogo.";}s:7:"premium";a:47:{s:5:"title";s:13:"Conta Premium";s:5:"intro";s:123:"A Conta Premium oferece vantagens de interface e conforto, mas não vantagens diretas de combate, garantindo um jogo justo.";s:15:"main_advantages";s:20:"Vantagens Principais";s:11:"build_queue";s:30:"Fila de Construção Aumentada";s:16:"build_queue_desc";s:58:"Permite adicionar mais edifícios à fila de construção.";s:9:"quick_bar";s:23:"Barra de Acesso Rápido";s:14:"quick_bar_desc";s:58:"Personalize atalhos para edifícios e páginas frequentes.";s:8:"map_view";s:32:"Visualização Dinâmica do Mapa";s:13:"map_view_desc";s:85:"Mapa maior e com mais opções de visualização (filtro de jogadores, aliados, etc).";s:16:"village_overview";s:22:"Visão Geral da Aldeia";s:21:"village_overview_desc";s:59:"Mais informações diretamente na visualização da aldeia.";s:8:"map_info";s:21:"Informações no Mapa";s:13:"map_info_desc";s:61:"Veja moral e tempo de viagem ao passar o mouse sobre aldeias.";s:15:"account_manager";s:16:"Gerente de Conta";s:20:"account_manager_desc";s:80:"Automatize construções, recrutamento e rotas comerciais (se ativado no mundo).";s:14:"farm_assistant";s:19:"Assistente de Saque";s:20:"farm_assistant_intro";s:152:"Uma ferramenta premium para facilitar o farm (saque) de aldeias bárbaras vizinhas. Permite configurar modelos de tropas e enviar ataques com um clique.";s:8:"resource";s:7:"Recurso";s:11:"description";s:11:"Descrição";s:19:"farm_assistant_desc";s:152:"Uma ferramenta premium para facilitar o farm (saque) de aldeias bárbaras vizinhas. Permite configurar modelos de tropas e enviar ataques com um clique.";s:14:"recent_reports";s:20:"Relatórios Recentes";s:19:"recent_reports_desc";s:58:"Mostra o último relatório de ataque nas aldeias do mapa.";s:10:"buttons_ab";s:13:"Botões A e B";s:15:"buttons_ab_desc";s:64:"Envie configurações pré-definidas de tropas instantaneamente.";s:21:"account_manager_intro";s:73:"Automatize a gestão do seu império. Ideal para quem tem muitas aldeias.";s:12:"construction";s:12:"Construção";s:17:"construction_desc";s:69:"Defina modelos de edifícios e o gerente construirá automaticamente.";s:5:"stock";s:7:"Estoque";s:10:"stock_desc";s:38:"Balanceie recursos entre suas aldeias.";s:11:"recruitment";s:12:"Recrutamento";s:16:"recruitment_desc";s:39:"Mantenha seus exércitos sempre cheios.";s:16:"production_bonus";s:20:"Bônus de Produção";s:21:"production_bonus_desc";s:52:"Aumente a produção das suas minas temporariamente.";s:10:"wood_bonus";s:29:"+20% na produção de madeira";s:10:"clay_bonus";s:28:"+20% na produção de argila";s:10:"iron_bonus";s:27:"+20% na produção de ferro";s:9:"cosmetics";s:10:"Cosmética";s:14:"cosmetics_desc";s:37:"Personalize a aparência do seu jogo.";s:13:"graphic_packs";s:17:"Pacotes Gráficos";s:18:"graphic_packs_desc";s:26:"Mude o visual do seu nome.";s:8:"animated";s:7:"Animado";s:8:"colorful";s:8:"Colorido";s:13:"village_skins";s:15:"Skins de Aldeia";s:18:"village_skins_desc";s:69:"Escolha diferentes estilos arquitetônicos para suas aldeias no mapa.";s:7:"example";s:2:"EX";s:13:"coats_of_arms";s:8:"Brasões";s:18:"coats_of_arms_desc";s:47:"Carregue brasões pessoais e de tribo animados.";}s:7:"paladin";a:4:{s:5:"title";s:18:"Paladino e Arsenal";s:5:"intro";s:117:"O Paladino é uma unidade especial que protege sua aldeia e pode encontrar itens poderosos para melhorar suas tropas.";s:11:"the_paladin";s:10:"O Paladino";s:11:"description";s:174:"Você pode nomear seu paladino. Se ele morrer, você pode recrutar um novo. O Paladino pode encontrar itens que, quando equipados, dão bônus ao exército que ele acompanha.";}s:6:"combat";a:27:{s:5:"title";s:18:"Sistema de Batalha";s:5:"intro";s:84:"Aqui encontra informações detalhadas sobre como funcionam os ataques e conquistas.";s:6:"morale";s:5:"Moral";s:11:"morale_desc";s:173:"A moral protege jogadores menores de ataques de jogadores muito maiores. Se o atacante tiver muito mais pontos que o defensor, suas tropas lutarão com eficiência reduzida.";s:13:"morale_status";s:15:"Status da Moral";s:6:"active";s:5:"Ativo";s:8:"disabled";s:10:"Desativado";s:11:"night_bonus";s:14:"Bônus Noturno";s:16:"night_bonus_desc";s:104:"Durante a noite, o defensor recebe um bônus de 100% na defesa. Isso incentiva o descanso dos jogadores.";s:8:"schedule";s:8:"Horário";s:4:"luck";s:5:"Sorte";s:9:"luck_desc";s:138:"A sorte é um fator aleatório em cada batalha, variando de -25% (má sorte) a +25% (boa sorte). Ela afeta diretamente a força de ataque.";s:4:"wall";s:7:"Muralha";s:9:"wall_desc";s:117:"A Muralha aumenta a defesa base da aldeia e dá um bônus percentual às tropas defensivas. É crucial para a defesa.";s:14:"conquest_title";s:20:"Conquista de Aldeias";s:14:"conquest_intro";s:55:"Para conquistar uma aldeia, precisa de um <b>Nobre</b>.";s:7:"loyalty";s:8:"Lealdade";s:12:"loyalty_desc";s:88:"Cada aldeia tem 100 de lealdade. Cada ataque bem-sucedido com um Nobre reduz a lealdade.";s:20:"reduction_per_attack";s:20:"Redução por ataque";s:2:"to";s:1:"a";s:6:"points";s:6:"pontos";s:8:"recovery";s:13:"Recuperação";s:23:"loyalty_recovery_prefix";s:15:"A lealdade sobe";s:23:"loyalty_recovery_suffix";s:15:"pontos por hora";s:13:"conquest_desc";s:125:"Quando a lealdade cai para 0 ou menos, a aldeia é conquistada e o Nobre desaparece, tornando-se o novo governante da aldeia.";s:4:"note";s:4:"Nota";s:13:"conquest_note";s:145:"Não pode conquistar sua última aldeia (auto-conquista depende das configurações) e não pode conquistar aldeias de iniciantes sob proteção.";}s:6:"market";a:11:{s:5:"title";s:7:"Mercado";s:5:"intro";s:96:"No Mercado, pode trocar recursos com outros jogadores ou enviá-los para suas próprias aldeias.";s:10:"basic_info";s:22:"Informações Básicas";s:21:"capacity_per_merchant";s:27:"Capacidade de cada mercador";s:14:"resources_1000";s:13:"1000 recursos";s:14:"merchant_speed";s:25:"Velocidade dos mercadores";s:17:"minutes_per_field";s:17:"minutos por campo";s:19:"merchants_per_level";s:21:"Mercadores por Nível";s:14:"merchants_desc";s:73:"Quanto maior o nível do seu Mercado, mais mercadores terá disponíveis.";s:12:"market_level";s:17:"Nível do Mercado";s:9:"merchants";s:10:"Mercadores";}s:3:"map";a:27:{s:5:"title";s:6:"O Mapa";s:5:"intro";s:136:"O mapa é o centro estratégico do jogo. Ele permite visualizar a vizinhança, localizar inimigos e aliados, e planejar suas expansões.";s:10:"navigation";s:11:"Navegação";s:15:"navigation_desc";s:158:"Pode arrastar o mapa com o mouse ou usar o minimapa para saltar grandes distâncias. Inserir coordenadas (X Y) leva-o diretamente a uma posição específica.";s:14:"colors_markers";s:18:"Cores e Marcadores";s:11:"colors_desc";s:80:"As aldeias no mapa são coloridas para facilitar a identificação diplomática:";s:12:"your_village";s:10:"Sua Aldeia";s:17:"your_village_desc";s:27:"Aldeias que pertencem a si.";s:10:"your_tribe";s:9:"Sua Tribo";s:15:"your_tribe_desc";s:32:"Aldeias de membros da sua tribo.";s:6:"allies";s:7:"Aliados";s:11:"allies_desc";s:47:"Tribos com relação de "Aliados" (Azul claro).";s:3:"pna";s:29:"PNA (Pacto de Não Agressão)";s:8:"pna_desc";s:32:"Tribos com acordo de paz (Roxo).";s:7:"enemies";s:8:"Inimigos";s:12:"enemies_desc";s:41:"Tribos marcadas como inimigas (Vermelho).";s:10:"barbarians";s:9:"Bárbaras";s:15:"barbarians_desc";s:34:"Aldeias abandonadas (Cor padrão).";s:10:"continents";s:11:"Continentes";s:15:"continents_desc";s:175:"O mundo é dividido em 100 continentes (K0 a K99). Cada continente tem 100x100 campos. As coordenadas ajudam a localizar em qual K uma aldeia está (ex: 255|355 está no K32).";s:12:"context_menu";s:16:"Menu de Contexto";s:17:"context_menu_desc";s:79:"Ao clicar em uma aldeia no mapa, um menu de contexto se abre com opções para:";s:11:"send_troops";s:13:"Enviar tropas";s:14:"send_resources";s:15:"Enviar recursos";s:12:"view_profile";s:21:"Ver perfil do jogador";s:13:"add_favorites";s:23:"Adicionar aos favoritos";s:15:"reserve_village";s:44:"Reservar aldeia (se compartilhado com tribo)";}s:6:"points";a:7:{s:5:"title";s:16:"Tabela de Pontos";s:5:"intro";s:135:"Aqui pode ver quantos pontos cada nível de construção adiciona à sua pontuação. Uma aldeia totalmente evoluída terá um total de";s:6:"points";s:6:"pontos";s:8:"building";s:9:"Edifício";s:5:"level";s:6:"Nível";s:5:"total";s:5:"Total";s:9:"breakdown";s:23:"Detalhamento por Nível";}s:5:"flags";a:34:{s:5:"title";s:9:"Bandeiras";s:5:"intro";s:194:"As bandeiras proporcionam bônus globais para a sua aldeia. Elas podem ser atribuídas a qualquer aldeia para aumentar a produção de recursos, força de combate, ou velocidade de recrutamento.";s:11:"system_note";s:15:"Nota do Sistema";s:16:"system_note_desc";s:99:"O sistema de bandeiras pode estar desativado neste mundo. Verifique as configurações do servidor.";s:9:"flag_type";s:16:"Tipo de Bandeira";s:6:"effect";s:6:"Efeito";s:9:"resources";s:8:"Recursos";s:19:"resource_production";s:22:"Produção de Recursos";s:24:"resource_production_desc";s:48:"Aumenta a produção de madeira, argila e ferro.";s:11:"recruitment";s:12:"Recrutamento";s:17:"recruitment_speed";s:26:"Velocidade de Recrutamento";s:22:"recruitment_speed_desc";s:49:"Reduz o tempo necessário para recrutar unidades.";s:6:"attack";s:6:"Ataque";s:15:"attack_strength";s:16:"Força de Ataque";s:20:"attack_strength_desc";s:37:"Aumenta a força ofensiva das tropas.";s:7:"defense";s:6:"Defesa";s:16:"defense_strength";s:16:"Força de Defesa";s:21:"defense_strength_desc";s:38:"Aumenta a força defensiva das tropas.";s:4:"luck";s:5:"Sorte";s:12:"luck_balance";s:19:"Sorte (Equilíbrio)";s:17:"luck_balance_desc";s:57:"Manipula a sorte em batalhas para ser mais próxima de 0.";s:10:"population";s:11:"População";s:19:"population_capacity";s:25:"Capacidade de População";s:24:"population_capacity_desc";s:51:"Aumenta o limite máximo de população da fazenda.";s:5:"coins";s:6:"Moedas";s:9:"coin_cost";s:15:"Custo de Moedas";s:14:"coin_cost_desc";s:41:"Reduz o custo para cunhar moedas de ouro.";s:4:"haul";s:5:"Saque";s:13:"haul_capacity";s:19:"Capacidade de Saque";s:18:"haul_capacity_desc";s:41:"Aumenta a capacidade de carga das tropas.";s:11:"flag_levels";s:20:"Níveis de Bandeiras";s:16:"flag_levels_desc";s:124:"Bandeiras podem ser atualizadas combinando 3 bandeiras do mesmo nível para criar uma de nível superior (máximo Nível 9).";s:7:"level_1";s:22:"Nível 1: Bônus Baixo";s:7:"level_9";s:24:"Nível 9: Bônus Extremo";}s:6:"church";a:4:{s:5:"title";s:12:"Igreja e Fé";s:5:"intro";s:134:"A Igreja aumenta a fé dos habitantes das aldeias ao seu redor. Tropas que lutam sem fé combatem com apenas 50% da sua força normal.";s:5:"faith";s:3:"Fé";s:10:"faith_desc";s:170:"A fé garante que as suas tropas lutem com 100% de eficácia. Certifique-se de que as suas aldeias de ataque e defesa estejam dentro do raio de influência de uma Igreja.";}s:10:"watchtower";a:4:{s:5:"title";s:14:"Torre de Vigia";s:5:"intro";s:137:"A Torre de Vigia ajuda a monitorizar a vizinhança. Ataques que entram no raio da torre são identificados e etiquetados automaticamente.";s:5:"range";s:17:"Raio de Cobertura";s:10:"range_desc";s:141:"Quanto maior o nível da Torre de Vigia, maior o seu raio visual no mapa, permitindo detectar ameaças muito antes de chegarem à sua aldeia.";}s:9:"inventory";a:4:{s:5:"title";s:19:"Inventário e Itens";s:5:"intro";s:83:"No seu Inventário, pode guardar itens consumíveis obtidos em eventos ou missões.";s:10:"activation";s:10:"Ativação";s:15:"activation_desc";s:148:"Itens podem ser ativados a qualquer momento para conceder bônus temporários de produção de recursos, aumento de velocidade ou bônus de combate.";}s:8:"conquest";a:4:{s:5:"title";s:20:"Conquista de Aldeias";s:5:"intro";s:87:"Para expandir o seu reino, precisa de conquistar outras aldeias usando um Nobre (Snob).";s:7:"loyalty";s:8:"Lealdade";s:12:"loyalty_desc";s:161:"Cada ataque bem-sucedido com um Nobre reduz a lealdade da aldeia alvo em 20 a 35 pontos. Quando a lealdade chega a 0 ou menos, a aldeia junta-se ao seu império.";}s:5:"am_fa";a:3:{s:5:"title";s:19:"Gestor & Assistente";s:5:"intro";s:62:"Ferramentas avançadas para automatizar e otimizar o seu jogo.";s:4:"desc";s:210:"O Assistente de Saque facilita o farm rápido com modelos pré-configurados de tropas. O Gestor de Conta automatiza a fila de construção, recrutamento de tropas e rotas de mercado quando tiver muitas aldeias.";}}
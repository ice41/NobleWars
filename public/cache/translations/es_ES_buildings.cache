a:19:{s:4:"main";a:2:{s:4:"name";s:18:"Edificio Principal";s:11:"description";s:122:"El Edificio Principal coordina todas las actividades de construcción. Cuanto mayor sea el nivel, más rápido construyes.";}s:8:"barracks";a:2:{s:4:"name";s:7:"Cuartel";s:11:"description";s:54:"En el Cuartel puedes reclutar unidades de infantería.";}s:6:"stable";a:2:{s:4:"name";s:7:"Establo";s:11:"description";s:54:"En el Establo puedes reclutar unidades de caballería.";}s:6:"garage";a:2:{s:4:"name";s:6:"Taller";s:11:"description";s:50:"En el Taller puedes construir máquinas de asedio.";}s:6:"church";a:2:{s:4:"name";s:7:"Iglesia";s:11:"description";s:67:"La Iglesia te permite reclutar monjes e influir en aldeas cercanas.";}s:8:"church_f";a:2:{s:4:"name";s:15:"Primera Iglesia";s:11:"description";s:109:"La Primera Iglesia te permite influir en aldeas cercanas. Solo puedes tener una Primera Iglesia en tu cuenta.";}s:4:"snob";a:2:{s:4:"name";s:8:"Academia";s:11:"description";s:66:"En la Academia puedes acuñar monedas de oro para reclutar nobles.";}s:5:"smith";a:2:{s:4:"name";s:9:"Herrería";s:11:"description";s:58:"En la Herrería puedes investigar mejoras para tus tropas.";}s:5:"place";a:2:{s:4:"name";s:17:"Punto de Reunión";s:11:"description";s:83:"En el Punto de Reunión puedes enviar tus tropas para atacar o apoyar otras aldeas.";}s:6:"statue";a:2:{s:4:"name";s:7:"Estatua";s:11:"description";s:42:"En la Estatua puedes reclutar un paladín.";}s:6:"market";a:2:{s:4:"name";s:7:"Mercado";s:11:"description";s:60:"En el Mercado puedes comerciar recursos con otros jugadores.";}s:4:"wood";a:2:{s:4:"name";s:20:"Campamento de Madera";s:11:"description";s:99:"El Campamento de Madera produce madera. Cuanto mayor sea el nivel, más madera se produce por hora.";}s:5:"stone";a:2:{s:4:"name";s:15:"Pozo de Arcilla";s:11:"description";s:96:"El Pozo de Arcilla produce arcilla. Cuanto mayor sea el nivel, más arcilla se produce por hora.";}s:4:"iron";a:2:{s:4:"name";s:14:"Mina de Hierro";s:11:"description";s:93:"La Mina de Hierro produce hierro. Cuanto mayor sea el nivel, más hierro se produce por hora.";}s:4:"farm";a:2:{s:4:"name";s:6:"Granja";s:11:"description";s:64:"La Granja aumenta la población disponible para reclutar tropas.";}s:7:"storage";a:2:{s:4:"name";s:8:"Almacén";s:11:"description";s:63:"El Almacén aumenta la capacidad de almacenamiento de recursos.";}s:4:"hide";a:2:{s:4:"name";s:9:"Escondite";s:11:"description";s:51:"El Escondite protege los recursos de ser saqueados.";}s:4:"wall";a:2:{s:4:"name";s:7:"Muralla";s:11:"description";s:50:"La Muralla aumenta la defensa básica de tu aldea.";}s:10:"watchtower";a:2:{s:4:"name";s:19:"Torre de Vigilancia";s:11:"description";s:98:"La Torre de Vigilancia detecta ataques entrantes y proporciona información sobre su composición.";}}
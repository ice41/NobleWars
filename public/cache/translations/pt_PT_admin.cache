us";a:34:{s:5:"title";s:25:"Gestão de Bónus Diário";s:4:"desc";s:46:"Configure as recompensas dos 31 baús diários";s:7:"success";s:40:"✓ Configuração guardada com sucesso!";s:12:"error_prefix";s:9:"✗ Erro:";s:7:"col_day";s:3:"Dia";s:14:"col_chest_type";s:12:"Tipo de Baú";s:15:"col_reward_type";s:18:"Tipo de Recompensa";s:8:"col_desc";s:11:"Descrição";s:11:"col_details";s:8:"Detalhes";s:11:"col_actions";s:7:"Ações";s:12:"chest_golden";s:12:"👑 Dourado";s:12:"chest_normal";s:11:"📦 Normal";s:8:"btn_edit";s:6:"Editar";s:10:"edit_title";s:17:"Editar Baú - Dia";s:16:"chest_type_label";s:13:"Tipo de Baú:";s:16:"chest_opt_normal";s:6:"Normal";s:16:"chest_opt_golden";s:7:"Dourado";s:17:"reward_type_label";s:19:"Tipo de Recompensa:";s:14:"reward_opt_res";s:8:"Recursos";s:18:"reward_opt_premium";s:14:"Pontos Premium";s:19:"reward_opt_features";s:16:"Features (AM/FA)";s:16:"reward_opt_items";s:5:"Itens";s:16:"reward_opt_flags";s:9:"Bandeiras";s:10:"desc_label";s:12:"Descrição:";s:8:"btn_save";s:20:"Guardar Alterações";s:8:"res_wood";s:8:"Madeira:";s:9:"res_stone";s:6:"Barro:";s:8:"res_iron";s:6:"Ferro:";s:11:"prem_points";s:15:"Pontos Premium:";s:7:"feat_am";s:24:"Dias de Gestor de Conta:";s:7:"feat_fa";s:28:"Dias de Assistente de Saque:";s:7:"item_id";s:11:"ID do Item:";s:8:"item_qty";s:11:"Quantidade:";s:10:"flag_level";s:19:"Nível da Bandeira:";}s:8:"massmail";a:12:{s:5:"title";s:27:"Mensagem Global (Mass Mail)";s:4:"desc";s:177:"Envia uma mensagem para a caixa de correio de todos os jogadores do mundo. O remetente aparecerá como "Equipa NobleWars" e os jogadores não poderão responder a esta mensagem.";s:7:"compose";s:16:"Redigir Mensagem";s:7:"subject";s:8:"Assunto:";s:19:"subject_placeholder";s:29:"Ex: Informações importantes";s:7:"message";s:9:"Mensagem:";s:8:"bb_codes";s:18:"(Suporta BB-Codes)";s:19:"message_placeholder";s:94:"Escreve aqui o texto da mensagem. Os jogadores receberão uma notificação normal de correio.";s:8:"send_btn";s:27:"ENVIAR A TODOS OS JOGADORES";s:11
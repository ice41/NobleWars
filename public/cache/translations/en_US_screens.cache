ion mode is used when you don't have time to play Tribal Wars (for example, during vacation]. You can designate another player to take care of your account. During this time, the player cannot attack other players with your account. If the substitution lasts more than 30 days, you will not be able to send resources or support to other players.";s:10:"substitute";s:11:"Substitute:";s:5:"start";s:5:"Start";s:3:"end";s:3:"End";s:6:"action";s:6:"Action";s:16:"end_substitution";s:16:"End substitution";}s:15:"settings_logins";a:7:{s:5:"title";s:5:"Login";s:11:"description";s:303:"On this page, you can see when there were logins and failed attempts to enter your account. If you discover that an unauthorized person has access to your account, you should change your password immediately. Depending on the connection type: the IP number may change when you reconnect to the Internet.";s:14:"last_20_logins";s:14:"Last 20 logins";s:4:"date";s:4:"Date";s:2:"ip";s:2:"IP";s:6:"deputy";s:6:"Deputy";s:9:"no_logins";s:19:"No logins recorded.";}s:13:"settings_poll";a:6:{s:5:"title";s:5:"Polls";s:11:"description";s:49:"Here you can participate in polls about the game.";s:4:"poll";s:4:"Poll";s:4:"date";s:4:"Date";s:6:"status";s:6:"Status";s:8:"no_polls";s:33:"No polls available at the moment.";}s:16:"settings_toolbar";a:14:{s:5:"title";s:28:"Customize Toolbar (Quickbar]";s:16:"visibility_title";s:19:"Quickbar Visibility";s:12:"show_toolbar";s:12:"Show toolbar";s:15:"save_visibility";s:15:"Save Visibility";s:14:"select_up_to_8";s:52:"Select up to 8 buildings to display in your toolbar.";s:19:"available_buildings";s:19:"Available Buildings";s:6:"select";s:6:"Select";s:8:"building";s:8:"Building";s:18:"save_configuration";s:18:"Save Configuration";s:8:"selected";s:9:"Selected:";s:13:"current_order";s:22:"Current Quickbar Order";s:21:"no_buildings_selected";s:21:"No buildings selected";s:3:"tip";s:4:"Tip:";s:15:"tip_description";s:130:"The order of buildings in the quickbar follows the select
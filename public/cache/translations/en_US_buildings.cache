a:20:{s:4:"main";a:2:{s:4:"name";s:4:"Main";s:11:"description";s:93:"The Main coordinates all construction activities. The higher the level, the faster you build.";}s:8:"barracks";a:2:{s:4:"name";s:8:"Barracks";s:11:"description";s:47:"In the Barracks you can recruit infantry units.";}s:6:"stable";a:2:{s:4:"name";s:6:"Stable";s:11:"description";s:44:"In the Stable you can recruit cavalry units.";}s:6:"garage";a:2:{s:4:"name";s:8:"Workshop";s:11:"description";s:45:"In the Workshop you can build siege machines.";}s:6:"church";a:2:{s:4:"name";s:6:"Church";s:11:"description";s:69:"The Church allows you to recruit monks and influence nearby villages.";}s:8:"church_f";a:2:{s:4:"name";s:12:"First Church";s:11:"description";s:109:"The First Church allows you to influence nearby villages. You can only have one First Church on your account.";}s:4:"snob";a:2:{s:4:"name";s:7:"Academy";s:11:"description";s:57:"In the Academy you can mint gold coins to recruit nobles.";}s:5:"smith";a:2:{s:4:"name";s:6:"Smithy";s:11:"description";s:60:"In the Smithy you can research improvements for your troops.";}s:5:"place";a:2:{s:4:"name";s:11:"Rally Point";s:11:"description";s:122:"All troops are at the rally point. Here you can give orders and move troops. The higher the level, the faster troops move.";}s:6:"statue";a:2:{s:4:"name";s:6:"Statue";s:11:"description";s:40:"At the Statue you can recruit a paladin.";}s:6:"market";a:2:{s:4:"name";s:6:"Market";s:11:"description";s:57:"At the Market you can trade resources with other players.";}s:4:"wood";a:2:{s:4:"name";s:11:"Timber Camp";s:11:"description";s:88:"The Timber Camp produces wood. The higher the level, the more wood is produced per hour.";}s:5:"stone";a:2:{s:4:"name";s:8:"Clay Pit";s:11:"description";s:85:"The Clay Pit produces clay. The higher the level, the more clay is produced per hour.";}s:4:"iron";a:2:{s:4:"name";s:9:"Iron Mine";s:11:"description";s:86:"The Iron Mine produces iron. The higher the level, the more iron is produced per hour.";}s:4:"farm";a:2:{s:4:"name";s:4:"Farm";s:11:"description";s:62:"The Farm increases the population available to recruit troops.";}s:7:"storage";a:2:{s:4:"name";s:9:"Warehouse";s:11:"description";s:59:"The Warehouse increases the storage capacity for resources.";}s:4:"hide";a:2:{s:4:"name";s:12:"Hiding Place";s:11:"description";s:54:"The Hiding Place protects resources from being looted.";}s:4:"wall";a:2:{s:4:"name";s:4:"Wall";s:11:"description";s:53:"The Wall increases the basic defense of your village.";}s:10:"watchtower";a:4:{s:4:"name";s:10:"Watchtower";s:11:"description";s:89:"The Watchtower detects incoming attacks and provides information about their composition.";s:3:"faq";a:11:{s:5:"title";s:26:"Frequently Asked Questions";s:2:"q1";s:70:"How do I know if an attack passes through the radius of my watchtower?";s:2:"a1";s:164:"Attacks marked by your watchtowers will have an "eye" icon next to the command. The attack will be marked as soon as it passes through the range of your watchtower.";s:2:"q2";s:77:"I just conquered a new village. Will my watchtower identify incoming attacks?";s:2:"a2";s:226:"Only attacks sent while you own the village will definitely be identified. Any command sent before you conquered the village will likely not be identified — you can check it by looking for the "eye" icon next to the command.";s:2:"q3";s:72:"I just built a new watchtower and it's not identifying incoming attacks!";s:2:"a3";s:227:"Only attacks sent after you build the watchtower will definitely be identified. Any command sent before you build the watchtower may not be identified. As always, you can check by looking for the "eye" icon next to the command!";s:2:"q4";s:191:"I'm trying to test the watchtower to see how it works, but my tribe mates' attacks are marked with or without the watchtower and I can't see the "eye" before they reach my watchtower's range!";s:2:"a4";s:228:"To test your watchtower, temporarily stop sharing commands with the player helping you test it. Sharing commands means all attacks are visible and automatically identified, so there's nothing left for the watchtower to identify!";s:2:"q5";s:69:"My watchtower only identified the attack when it was about to happen!";s:2:"a5";s:276:"Watchtowers will only identify an attack when it enters their range. If the village being attacked is near the edge of your radius, it will only be identified shortly before the attack happens! You may need to upgrade the watchtower or build a new one to expand your coverage!";}s:16:"related_articles";a:6:{s:5:"title";s:16:"Related Articles";s:4:"main";s:4:"Main";s:8:"barracks";s:8:"Barracks";s:6:"stable";s:6:"Stable";s:6:"garage";s:8:"Workshop";s:6:"church";s:6:"Church";}}s:5:"popup";a:5:{s:9:"max_level";s:26:"Maximum development level:";s:12:"requirements";s:24:"Building levels required";s:5:"level";s:5:"Level";s:5:"costs";s:5:"Costs";s:13:"pop_and_total";s:18:"Population / Total";}}
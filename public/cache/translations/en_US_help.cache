a:16:{s:4:"main";a:8:{s:5:"title";s:16:"Game Help (Wiki)";s:7:"welcome";s:102:"Welcome to the game help. Here you will find information about the game, its mechanics and statistics.";s:15:"buildings_title";s:9:"Buildings";s:14:"buildings_desc";s:65:"Detailed information about all buildings, costs and requirements.";s:11:"units_title";s:5:"Units";s:10:"units_desc";s:48:"Combat statistics, speed and costs of all units.";s:14:"bb_codes_title";s:8:"BB-Codes";s:13:"bb_codes_desc";s:50:"How to format text in forum, messages and profile.";}s:9:"buildings";a:4:{s:5:"title";s:9:"Buildings";s:5:"intro";s:59:"Here you can find detailed information about each building.";s:5:"table";a:5:{s:8:"building";s:8:"Building";s:9:"max_level";s:9:"Max Level";s:11:"description";s:11:"Description";s:5:"level";s:5:"Level";s:6:"points";s:6:"Points";}s:9:"resources";a:4:{s:4:"wood";s:4:"Wood";s:4:"clay";s:4:"Clay";s:4:"iron";s:4:"Iron";s:10:"population";s:10:"Population";}}s:5:"units";a:10:{s:5:"title";s:5:"Units";s:5:"intro";s:45:"Overview of all units available in the world.";s:5:"table";a:4:{s:4:"unit";s:4:"Unit";s:5:"speed";s:5:"Speed";s:5:"carry";s:5:"Carry";s:12:"recruited_in";s:12:"Recruited in";}s:17:"minutes_per_field";s:17:"minutes per field";s:5:"costs";s:5:"Costs";s:6:"combat";s:6:"Combat";s:6:"attack";s:6:"Attack";s:15:"defense_general";s:15:"General Defense";s:15:"defense_cavalry";s:15:"Cavalry Defense";s:15:"defense_archers";s:14:"Archer Defense";}s:8:"bb_codes";a:39:{s:6:"legend";s:6:"Legend";s:4:"bold";s:4:"Bold";s:6:"italic";s:6:"Italic";s:9:"underline";s:9:"Underline";s:13:"strikethrough";s:13:"Strikethrough";s:5:"quote";s:5:"Quote";s:4:"link";s:11:"Insert link";s:7:"spoiler";s:7:"Spoiler";s:6:"player";s:6:"Player";s:5:"tribe";s:5:"Tribe";s:11:"coordinates";s:11:"Coordinates";s:6:"report";s:13:"Insert report";s:9:"font_size";s:9:"Font Size";s:5:"image";s:12:"Insert image";s:5:"color";s:10:"Text color";s:5:"codes";s:5:"Codes";s:4:"code";s:4:"Code";s:5:"forum";s:5:"Forum";s:7:"message";s:7:"Message";s:7:"profile";s:7:"Profile";s:5:"title";s:8:"BB-Codes";s:5:"intro";s:94:"BB-Codes are special codes used to format texts in messages, tribe forums and player profiles.";s:12:"format_title";s:56:"Text Formatting (Bold, Italic, Underline, Strikethrough)";s:11:"color_title";s:14:"Colors (Color)";s:10:"size_title";s:16:"Font Size (Size)";s:11:"quote_title";s:13:"Quote (Quote)";s:10:"link_title";s:11:"Links / URL";s:14:"entities_title";s:18:"Players and Tribes";s:12:"coords_title";s:22:"Coordinates (Map Link)";s:13:"spoiler_title";s:7:"Spoiler";s:9:"img_title";s:14:"Images (Image)";s:12:"report_title";s:7:"Reports";s:14:"building_title";s:20:"Buildings (Building)";s:10:"unit_title";s:12:"Units (Unit)";s:11:"table_title";s:14:"Tables (Table)";s:12:"how_it_looks";s:13:"How it looks:";s:13:"building_desc";s:52:"Displays the graphic icon of a building in the game.";s:9:"unit_desc";s:54:"Displays the graphic icon of a troop unit in the game.";s:10:"table_desc";s:103:"Allows creating formatted tables. Supports both standard HTML-style tags and simplified bracket syntax.";}s:7:"premium";a:47:{s:5:"title";s:15:"Premium Account";s:5:"intro";s:117:"The Premium Account offers interface and comfort advantages, but no direct combat advantages, ensuring fair gameplay.";s:15:"main_advantages";s:15:"Main Advantages";s:11:"build_queue";s:20:"Extended Build Queue";s:16:"build_queue_desc";s:48:"Allows adding more buildings to the build queue.";s:9:"quick_bar";s:16:"Quick Access Bar";s:14:"quick_bar_desc";s:53:"Customize shortcuts for buildings and frequent pages.";s:8:"map_view";s:16:"Dynamic Map View";s:13:"map_view_desc";s:66:"Larger map with more viewing options (player filter, allies, etc).";s:16:"village_overview";s:16:"Village Overview";s:21:"village_overview_desc";s:46:"More information directly in the village view.";s:8:"map_info";s:15:"Map Information";s:13:"map_info_desc";s:55:"See morale and travel time when hovering over villages.";s:15:"account_manager";s:15:"Account Manager";s:20:"account_manager_desc";s:78:"Automate construction, recruitment and trade routes (if enabled in the world).";s:14:"farm_assistant";s:14:"Farm Assistant";s:20:"farm_assistant_intro";s:147:"A premium tool to facilitate farming (raiding) of nearby barbarian villages. Allows configuring troop templates and sending attacks with one click.";s:8:"resource";s:8:"Resource";s:11:"description";s:11:"Description";s:19:"farm_assistant_desc";s:147:"A premium tool to facilitate farming (raiding) of nearby barbarian villages. Allows configuring troop templates and sending attacks with one click.";s:14:"recent_reports";s:14:"Recent Reports";s:19:"recent_reports_desc";s:52:"Shows the last attack report on villages on the map.";s:10:"buttons_ab";s:15:"Buttons A and B";s:15:"buttons_ab_desc";s:48:"Send pre-defined troop configurations instantly.";s:21:"account_manager_intro";s:75:"Automate the management of your empire. Ideal for those with many villages.";s:12:"construction";s:12:"Construction";s:17:"construction_desc";s:67:"Define building templates and the manager will build automatically.";s:5:"stock";s:5:"Stock";s:10:"stock_desc";s:40:"Balance resources between your villages.";s:11:"recruitment";s:11:"Recruitment";s:16:"recruitment_desc";s:29:"Keep your armies always full.";s:16:"production_bonus";s:16:"Production Bonus";s:21:"production_bonus_desc";s:50:"Temporarily increase the production of your mines.";s:10:"wood_bonus";s:20:"+20% wood production";s:10:"clay_bonus";s:20:"+20% clay production";s:10:"iron_bonus";s:20:"+20% iron production";s:9:"cosmetics";s:9:"Cosmetics";s:14:"cosmetics_desc";s:38:"Customize the appearance of your game.";s:13:"graphic_packs";s:13:"Graphic Packs";s:18:"graphic_packs_desc";s:29:"Change the look of your name.";s:8:"animated";s:8:"Animated";s:8:"colorful";s:8:"Colorful";s:13:"village_skins";s:13:"Village Skins";s:18:"village_skins_desc";s:67:"Choose different architectural styles for your villages on the map.";s:7:"example";s:2:"EX";s:13:"coats_of_arms";s:13:"Coats of Arms";s:18:"coats_of_arms_desc";s:49:"Upload animated personal and tribe coats of arms.";}s:7:"paladin";a:4:{s:5:"title";s:19:"Paladin and Arsenal";s:5:"intro";s:108:"The Paladin is a special unit that protects your village and can find powerful items to improve your troops.";s:11:"the_paladin";s:11:"The Paladin";s:11:"description";s:154:"You can name your paladin. If he dies, you can recruit a new one. The Paladin can find items that, when equipped, give bonuses to the army he accompanies.";}s:6:"combat";a:27:{s:5:"title";s:13:"Battle System";s:5:"intro";s:77:"Here you will find detailed information about how attacks and conquests work.";s:6:"morale";s:6:"Morale";s:11:"morale_desc";s:173:"Morale protects smaller players from attacks by much larger players. If the attacker has many more points than the defender, their troops will fight with reduced efficiency.";s:13:"morale_status";s:13:"Morale Status";s:6:"active";s:6:"Active";s:8:"disabled";s:8:"Disabled";s:11:"night_bonus";s:11:"Night Bonus";s:16:"night_bonus_desc";s:94:"During the night, the defender receives a 100% defense bonus. This encourages players to rest.";s:8:"schedule";s:8:"Schedule";s:4:"luck";s:4:"Luck";s:9:"luck_desc";s:126:"Luck is a random factor in each battle, ranging from -25% (bad luck) to +25% (good luck). It directly affects attack strength.";s:4:"wall";s:4:"Wall";s:9:"wall_desc";s:122:"The Wall increases the village's base defense and gives a percentage bonus to defensive troops. It is crucial for defense.";s:14:"conquest_title";s:16:"Village Conquest";s:14:"conquest_intro";s:46:"To conquer a village, you need a <b>Noble</b>.";s:7:"loyalty";s:7:"Loyalty";s:12:"loyalty_desc";s:82:"Each village has 100 loyalty. Each successful attack with a Noble reduces loyalty.";s:20:"reduction_per_attack";s:20:"Reduction per attack";s:2:"to";s:2:"to";s:6:"points";s:6:"points";s:8:"recovery";s:8:"Recovery";s:23:"loyalty_recovery_prefix";s:13:"Loyalty rises";s:23:"loyalty_recovery_suffix";s:15:"points per hour";s:13:"conquest_desc";s:123:"When loyalty drops to 0 or below, the village is conquered and the Noble disappears, becoming the new ruler of the village.";s:4:"note";s:4:"Note";s:13:"conquest_note";s:131:"You cannot conquer your last village (self-conquest depends on settings) and you cannot conquer beginner villages under protection.";}s:6:"market";a:11:{s:5:"title";s:6:"Market";s:5:"intro";s:92:"In the Market, you can trade resources with other players or send them to your own villages.";s:10:"basic_info";s:17:"Basic Information";s:21:"capacity_per_merchant";s:21:"Capacity per merchant";s:14:"resources_1000";s:14:"1000 resources";s:14:"merchant_speed";s:14:"Merchant speed";s:17:"minutes_per_field";s:17:"minutes per field";s:19:"merchants_per_level";s:19:"Merchants per Level";s:14:"merchants_desc";s:80:"The higher the level of your Market, the more merchants you will have available.";s:12:"market_level";s:12:"Market Level";s:9:"merchants";s:9:"Merchants";}s:3:"map";a:27:{s:5:"title";s:7:"The Map";s:5:"intro";s:137:"The map is the strategic center of the game. It allows you to view the neighborhood, locate enemies and allies, and plan your expansions.";s:10:"navigation";s:10:"Navigation";s:15:"navigation_desc";s:148:"You can drag the map with the mouse or use the minimap to jump long distances. Entering coordinates (X Y) takes you directly to a specific position.";s:14:"colors_markers";s:18:"Colors and Markers";s:11:"colors_desc";s:72:"Villages on the map are colored to facilitate diplomatic identification:";s:12:"your_village";s:12:"Your Village";s:17:"your_village_desc";s:28:"Villages that belong to you.";s:10:"your_tribe";s:10:"Your Tribe";s:15:"your_tribe_desc";s:34:"Villages of members of your tribe.";s:6:"allies";s:6:"Allies";s:11:"allies_desc";s:47:"Tribes with "Allies" relationship (Light blue).";s:3:"pna";s:25:"NAP (Non-Aggression Pact)";s:8:"pna_desc";s:37:"Tribes with peace agreement (Purple).";s:7:"enemies";s:7:"Enemies";s:12:"enemies_desc";s:31:"Tribes marked as enemies (Red).";s:10:"barbarians";s:10:"Barbarians";s:15:"barbarians_desc";s:35:"Abandoned villages (Default color).";s:10:"continents";s:10:"Continents";s:15:"continents_desc";s:161:"The world is divided into 100 continents (K0 to K99). Each continent has 100x100 fields. Coordinates help locate which K a village is in (ex: 255|355 is in K32).";s:12:"context_menu";s:12:"Context Menu";s:17:"context_menu_desc";s:76:"When clicking on a village on the map, a context menu opens with options to:";s:11:"send_troops";s:11:"Send troops";s:14:"send_resources";s:14:"Send resources";s:12:"view_profile";s:19:"View player profile";s:13:"add_favorites";s:16:"Add to favorites";s:15:"reserve_village";s:38:"Reserve village (if shared with tribe)";}s:6:"points";a:7:{s:5:"title";s:12:"Points Table";s:5:"intro";s:119:"Here you can see how many points each building level adds to your score. A fully developed village will have a total of";s:6:"points";s:6:"points";s:8:"building";s:8:"Building";s:5:"level";s:5:"Level";s:5:"total";s:5:"Total";s:9:"breakdown";s:18:"Breakdown by Level";}s:5:"flags";a:34:{s:5:"title";s:5:"Flags";s:5:"intro";s:154:"Flags provide global bonuses for your village. They can be assigned to any village to increase resource production, combat strength, or recruitment speed.";s:11:"system_note";s:11:"System Note";s:16:"system_note_desc";s:73:"The flag system may be disabled in this world. Check the server settings.";s:9:"flag_type";s:9:"Flag Type";s:6:"effect";s:6:"Effect";s:9:"resources";s:9:"Resources";s:19:"resource_production";s:19:"Resource Production";s:24:"resource_production_desc";s:41:"Increases wood, clay and iron production.";s:11:"recruitment";s:11:"Recruitment";s:17:"recruitment_speed";s:17:"Recruitment Speed";s:22:"recruitment_speed_desc";s:41:"Reduces the time needed to recruit units.";s:6:"attack";s:6:"Attack";s:15:"attack_strength";s:15:"Attack Strength";s:20:"attack_strength_desc";s:43:"Increases the offensive strength of troops.";s:7:"defense";s:7:"Defense";s:16:"defense_strength";s:16:"Defense Strength";s:21:"defense_strength_desc";s:43:"Increases the defensive strength of troops.";s:4:"luck";s:4:"Luck";s:12:"luck_balance";s:14:"Luck (Balance)";s:17:"luck_balance_desc";s:46:"Manipulates luck in battles to be closer to 0.";s:10:"population";s:10:"Population";s:19:"population_capacity";s:19:"Population Capacity";s:24:"population_capacity_desc";s:51:"Increases the maximum population limit of the farm.";s:5:"coins";s:5:"Coins";s:9:"coin_cost";s:9:"Coin Cost";s:14:"coin_cost_desc";s:36:"Reduces the cost to mint gold coins.";s:4:"haul";s:4:"Haul";s:13:"haul_capacity";s:13:"Haul Capacity";s:18:"haul_capacity_desc";s:42:"Increases the carrying capacity of troops.";s:11:"flag_levels";s:11:"Flag Levels";s:16:"flag_levels_desc";s:108:"Flags can be upgraded by combining 3 flags of the same level to create a higher level one (maximum Level 9).";s:7:"level_1";s:18:"Level 1: Low Bonus";s:7:"level_9";s:22:"Level 9: Extreme Bonus";}s:6:"church";a:4:{s:5:"title";s:14:"Church & Faith";s:5:"intro";s:137:"The Church increases the faith of the inhabitants of nearby villages. Troops fighting without faith combat at only 50% of their strength.";s:5:"faith";s:5:"Faith";s:10:"faith_desc";s:146:"Faith ensures your troops fight with 100% efficiency. Make sure your attacking and defending villages are within the influence radius of a Church.";}s:10:"watchtower";a:4:{s:5:"title";s:10:"Watchtower";s:5:"intro";s:123:"The Watchtower helps monitor the neighborhood. Attacks entering the tower's radius are automatically identified and tagged.";s:5:"range";s:15:"Coverage Radius";s:10:"range_desc";s:141:"The higher the Watchtower level, the larger its visual radius on the map, allowing you to detect threats long before they reach your village.";}s:9:"inventory";a:4:{s:5:"title";s:17:"Inventory & Items";s:5:"intro";s:81:"In your Inventory, you can store consumable items obtained from events or quests.";s:10:"activation";s:10:"Activation";s:15:"activation_desc";s:117:"Items can be activated at any time to grant temporary resource production boosts, speed increases, or combat bonuses.";}s:8:"conquest";a:4:{s:5:"title";s:19:"Conquering Villages";s:5:"intro";s:83:"To expand your kingdom, you need to conquer other villages using a Nobleman (Snob).";s:7:"loyalty";s:7:"Loyalty";s:12:"loyalty_desc";s:158:"Each successful attack with a Nobleman reduces the target village's loyalty by 20 to 35 points. When loyalty reaches 0 or less, the village joins your empire.";}s:5:"am_fa";a:3:{s:5:"title";s:19:"Manager & Assistant";s:5:"intro";s:54:"Advanced tools to automate and optimize your gameplay.";s:4:"desc";s:197:"The Farm Assistant makes fast farming easier with pre-configured troop templates. The Account Manager automates the building queue, troop recruitment, and market routes when you have many villages.";}}
var EventPlayerEnergy;(EventPlayerEnergy=function(e){this.update(e)}).prototype={on_change:[],last_value:0,onChange:function(e){this.on_change.push(e)},getValue:function(){return Math.floor(this.getRawValue())},getMaxValue:function(){return this.max_value},getRawValue:function(){var e=Timing.getCurrentServerTime()/1e3;return Math.min(this.max_value,this.snapshot_value+(e-this.snapshot_time)/this.recharge_seconds)},getNextChargeWaitSeconds:function(){var e=this.getRawValue(),t=Math.round(e+.5);return Math.ceil(this.recharge_seconds*(t-e))},update:function(e){this.energy_type=e.energy_type,this.max_value=e.max_value,this.recharge_seconds=e.recharge_seconds,this.snapshot_value=e.snapshot_value,this.snapshot_time=e.snapshot_time,this.notifyChange()},tick:function(){var e=this.last_value,t=this.getValue();e!=(this.last_value=t)&&this.notifyChange()},notifyChange:function(){var t=this;this.on_change.forEach(function(e){e(t)})}},EventPlayerEnergy.createMapFromDTO=function(e){let n={};return $.each(e,function(e,t){n[e]=new EventPlayerEnergy(t)}),n};

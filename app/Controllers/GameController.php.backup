            'place_sim' => 'App\\Controllers\\Screens\\PlaceSimScreen',
            'place_units' => 'App\\Controllers\\Screens\\PlaceUnitsScreen',
            'popup' => 'App\\Controllers\\Screens\\PopupScreen',
            'market' => 'App\\Controllers\\Screens\\MarketScreen',
            'smith' => 'App\\Controllers\\Screens\\SmithScreen',

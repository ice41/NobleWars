    {
        $screenMap = [
            'welcome' => 'App\\Controllers\\Screens\\WelcomeScreen',
            'overview' => 'App\\Controllers\\Screens\\OverviewScreen',
            'event_horse_race' => 'App\\Controllers\\Screens\\EventHorseRaceScreen',

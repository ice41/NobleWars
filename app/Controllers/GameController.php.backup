<?php

namespace App\Controllers;

use App\Core\View;
use App\Core\Database;
use App\Core\LanguageManager;
use App\Models\SessionModel;
use App\Models\VillageModel;
use App\Models\AuthModel;

class GameController
{
    private $sessionModel;
    private $villageModel;
    private $authModel;
    private $userModel;

    public function __construct()
    {
        // Set Security Headers
        \App\Helpers\SecurityHelper::setHeaders();

        $this->authModel = new AuthModel();

        // Initialize language system
        require_once __DIR__ . '/../Helpers/language_helper.php';

        // Try to load user's language preference from database if logged in
        $server = get_active_world();
        $cookieName = 'session_' . $server;

        if (isset($_COOKIE[$cookieName])) {
            try {
                $globalDb = \App\Core\Database::getInstance(\App\Core\Database::getGlobalDbName());
                $sessionData = $globalDb->fetch("SELECT userid FROM session WHERE sid = ?", [$_COOKIE[$cookieName]]);

                if ($sessionData) {
                    $userData = $globalDb->fetch("SELECT language FROM conta WHERE id = ?", [$sessionData['userid']]);
                    if ($userData && !empty($userData['language'])) {
                        // User has a saved language preference - use it
                        set_locale($userData['language']);
                    } else {
                        // No saved preference - use auto-detection
                        init_locale();
                    }
                } else {
                    init_locale();
                }
            } catch (\Exception $e) {
                // If anything fails, fall back to auto-detection
                init_locale();
            }
        } else {
            // Not logged in - use auto-detection
            init_locale();
        }

        // Session and Village models depend on the world, so we instantiate them in index()
    }

    public function index()
    {
        // Self-healing check for Bot Daemon
        \App\Helpers\BotDaemonHelper::checkAndStart();

        // Detetar o mundo ativo (subdomínio em produção, ?world= em local)
        $server = get_active_world();
        $_SESSION['world'] = $server;
        $worldDb = get_world_db_name($server);

        $this->sessionModel = new SessionModel($worldDb);
        $this->villageModel = new VillageModel($worldDb);
        $this->userModel = new \App\Models\UserModel($worldDb);
        
        // Load world configuration
        global $config, $arr_production, $arr_maxstorage, $arr_farm, $arr_maxhide, $cl_builds, $cl_units;
        $configFile = __DIR__ . '/../Config/Worlds/' . $server . '.php';
        if (file_exists($configFile)) {
            $config = require $configFile;
            
            // Extract common arrays for legacy script compatibility
            $arr_production = $config['arr_production'] ?? [];
            $arr_maxstorage = $config['arr_maxstorage'] ?? [];
            $arr_farm = $config['arr_farm'] ?? [];
            $arr_maxhide = $config['arr_maxhide'] ?? [];

            // ── EVENT AUTO-EXPIRY ─────────────────────────────────────────────────
            // When an event ends, it stays active for a 24 h grace period so
            // players can still access the shop. Once that window closes, the
            // _active flag is set to FALSE both in memory AND written back to the
            // world config file on disk — so the admin panel shows it as disabled
            // and the change persists permanently (no cron job needed).
            $now         = time();
            $gracePeriod = 24 * 3600; // 24 hours in seconds

            $eventsToCheck = [
                'horse_race' => [
                    'active' => 'event_horse_race_active',
                    'end'    => 'event_horse_race_end',
                ],
                'horde' => [
                    'active' => 'event_horde_active',
                    'end'    => 'event_horde_end',
                ],
                'spring' => [
                    'active' => 'event_spring_active',
                    'end'    => 'event_spring_end',
                ],
            ];

            $configNeedsSave = false;

            foreach ($eventsToCheck as $eventData) {
                $activeKey = $eventData['active'];
                $endKey    = $eventData['end'];

                // Only check events that are still marked as active and have an end date
                if (empty($config[$activeKey]) || empty($config[$endKey])) {
                    continue;
                }

                // Parse end date — supports "d.m.Y H:i" (30.05.2026 00:00)
                // and ISO formats from datetime-local inputs (2026-05-30T00:00)
                $endStr = $config[$endKey];
                $endTs  = false;

                $dt = \DateTime::createFromFormat('d.m.Y H:i', $endStr);
                if ($dt) {
                    $endTs = $dt->getTimestamp();
                }

                if ($endTs === false) {
                    $dt = date_create($endStr);
                    if ($dt) {
                        $endTs = $dt->getTimestamp();
                    }
                }

                // Grace period expired → deactivate
                if ($endTs !== false && $now > ($endTs + $gracePeriod)) {
                    $config[$activeKey] = false;
                    $configNeedsSave    = true;
                }
            }

            // Write deactivated events back to the config file on disk
            if ($configNeedsSave && is_writable($configFile)) {
                $fileContent = file_get_contents($configFile);

                foreach ($eventsToCheck as $eventData) {
                    $activeKey = $eventData['active'];

                    // Only rewrite keys we just deactivated
                    if (!empty($config[$activeKey])) {
                        continue; // still active, skip
                    }

                    // Replace 'event_X_active' => true  with  'event_X_active' => false,
                    $fileContent = preg_replace(
                        "/(['\"]" . preg_quote($activeKey, '/') . "['\"]\\s*=>\\s*)true(,?)/",
                        '$1false$2',
                        $fileContent
                    );
                }

                file_put_contents($configFile, $fileContent);
                if (function_exists('opcache_invalidate')) {
                    @opcache_invalidate($configFile, true);
                }
            }
            // ─────────────────────────────────────────────────────────────────────

        } else {
            // Fallback to default if world-specific config is missing
            $config = [];
            $arr_production = [];
        }

        // Check if session cookie exists
        $cookieName = 'session_' . $server;
        if (!isset($_COOKIE[$cookieName])) {
            header('Location: index.php');
            exit;
        }

        $sid = $_COOKIE[$cookieName];
        $session = $this->sessionModel->checkSession($sid);

        if (!$session) {
            header('Location: index.php');
            exit;
        }

        $userId = $session['userid'];
        $userGlobal = $this->authModel->getUserById($userId);
        $userWorld = $this->userModel->getUserGameData($userId);

        if (!$userGlobal) {
            header('Location: index.php');
            exit;
        }

        if (!$userGlobal) {
            header('Location: index.php');
            exit;
        }

        // Logic removed: User MUST exist in world DB (via create_village.php) 
        // Otherwise they won't have a village and will be redirected there anyway loop below.
        if (!$userWorld) {
            // Do not auto-create. Redirect loop will handle sending them to create_village.php
            // But we need to handle the case where userWorld is null in the merge below.
        } else {
            // Sync logic if needed
            if ($userWorld['points'] == 0) {
                // $this->userModel->syncPoints($userId); // logic kept or removed?
                // Let's keep sync if they exist but have 0 points, just to be safe.
                $this->userModel->syncPoints($userId);
                $userWorld = $this->userModel->getUserGameData($userId);
            }
        }

        // Merge global and world data (World data takes precedence for game stats)
        $user = array_merge($userGlobal, $userWorld ? $userWorld : []);

        // Set dynamic visual theme based on user settings
        $ingame_theme = !empty($user['theme']) ? $user['theme'] : ($GLOBALS['conf']['ingame_theme'] ?? 'modern');
        $GLOBALS['conf']['ingame_theme'] = $ingame_theme;

        // Parse registered worlds into an array
        $user['registered_worlds'] = [];
        if (isset($userGlobal['serwery_gry']) && !empty($userGlobal['serwery_gry'])) {
            $user['registered_worlds'] = array_filter(explode(';', (string)$userGlobal['serwery_gry']));
        }

        // Read precalculated player ranking from the database (calculated in background by the daemon)
        $user['rang'] = isset($user['rang']) ? (int)$user['rang'] : 1;

        // --- NEW ORDER: Events BEFORE Village Load ---

        // 1. Initialize World DB connection
        $worldDbInstance = Database::getInstance($worldDb);

        // Update user's last activity timestamp for online players count (throttled to every 30 seconds)
        try {
            $currentTime = time();
            if (!isset($_SESSION['last_activity_update']) || ($currentTime - $_SESSION['last_activity_update']) > 30) {
                $worldDbInstance->query("UPDATE users SET last_activity = ? WHERE id = ?", [$currentTime, $userId]);
                $_SESSION['last_activity_update'] = $currentTime;
            }
        } catch (\Exception $e) {
            error_log("Failed to update last_activity: " . $e->getMessage());
        }

        // 2. Process Global Events/Legacy Events (Builds, Research, etc.)
        // Define global connection for legacy scripts
        $pdo = $worldDbInstance->getPdo();
        $pdo->exec("SET SESSION sql_mode = ''"); // MariaDB strict mode compatibility
        $GLOBALS['pdo_legacy_connection'] = $pdo;

        // Init legacy globals required by events.php
        $cl_builds = new \App\Models\BuildsLibrary($worldDb, $config);
        $GLOBALS['cl_builds'] = $cl_builds;

        $cl_units = new \App\Models\UnitsLibrary($worldDb, $config);
        $GLOBALS['cl_units'] = $cl_units;

        // Init impl_units global (Required for events.php support logic)
        $impl_units = implode(',', $cl_units->get_array("dbname"));
        $GLOBALS['impl_units'] = $impl_units;

        // Initialize Awards Library
        $awardsLib = new \App\Models\AwardsLibrary($worldDbInstance);
        $GLOBALS['awards'] = $awardsLib;

        // Reload user awards on each page load
        if (isset($userId)) {
            $awardsLib->reload_user_awards($userId);
        }


        // Include compatibility layer and legacy events (attack/support movements)
        // Must be done BEFORE EventProcessor so legacy functions are available.
        if (file_exists('modelo/lib/mysql_compat.php')) {
            require_once 'modelo/lib/mysql_compat.php';
        }
        if (file_exists('modelo/lib/events.php')) {
            require_once 'modelo/lib/events.php';
        }

        // 3. Get village (Now loads UPDATED state from DB)
        $villageId = isset($_GET['village']) ? (int) $_GET['village'] : null;
        if ($villageId) {
            $village = $this->villageModel->getVillageById($villageId);
            if (!$village || $village['userid'] != $userId) {
                $village = $this->villageModel->getFirstVillageByUserId($userId);
            }
        } else {
            $village = $this->villageModel->getFirstVillageByUserId($userId);
        }

        if (!$village) {
            header('Location: ' . get_world_url($server, 'create_village.php'));
            exit;
        }

        // Process modern events (merchants, builds, research, etc) with EventProcessor
        try {
            $eventProcessor = new \App\Services\EventProcessor($worldDbInstance);
            $eventProcessor->processAll(150, $userId, $village['id']);
        } catch (\Exception $e) {
            error_log("Event Processor Error: " . $e->getMessage());
        }

        // Process Account Manager automations (every 2 minutes)
        if (!isset($_SESSION['last_am_automation']) || (time() - $_SESSION['last_am_automation']) > 120) {
            try {
                $automation = new \App\Helpers\AccountManagerAutomation($worldDb);
                $automation->processUserAutomations($userId);
                $automation->processDeliveries();
                if (!isset($_SESSION['last_stock_distribution']) || (time() - $_SESSION['last_stock_distribution']) > 3600) {
                    $automation->processStockDistribution($userId);
                    $_SESSION['last_stock_distribution'] = time();
                }
                $_SESSION['last_am_automation'] = time();
            } catch (\Exception $e) {
                error_log("Account Manager Automation Error: " . $e->getMessage());
            }
        }

        // CRITICAL: Update village resources and recruitment from production
        // This updates resources and recruitment state in the database and reloads the village array
        $this->villageModel->processProduction($village);

        // Previous/Next Village Logic
        $userVillages = $this->villageModel->getVillagesByUserId($userId);
        $villages_count = count($userVillages);
        $current_v_index = 0;

        // Find current index
        foreach ($userVillages as $idx => $v) {
            if ($v['id'] == $village['id']) {
                $current_v_index = $idx;
                break;
            }
        }

        // Calculate prev/next indices (cyclic)
        $prev_index = ($current_v_index - 1 + $villages_count) % $villages_count;
        $next_index = ($current_v_index + 1) % $villages_count;

        $village['prev_id'] = $userVillages[$prev_index]['id'];
        $village['next_id'] = $userVillages[$next_index]['id'];



        // 5. Screen logic
        $screen = isset($_GET['screen']) ? $_GET['screen'] : 'welcome';

        $screenClass = $this->getScreenController($screen);
        if ($screenClass) {
            $screenController = new $screenClass($user, $village, $session, $worldDbInstance);

            // Handle screen-specific actions
            if (isset($_GET['action']) && method_exists($screenController, 'handleAction')) {
                $screenController->handleAction($_GET['action']);
            }

            $screenContent = $screenController->render();
        } else {
            $screenContent = "<p>Screen '$screen' not implemented yet.</p>";
        }

        // Handle global actions
        if (isset($_GET['action']) && $_GET['action'] == 'logout') {
            header('Location: index.php?action=logout&csrf_token=' . ($_SESSION['csrf_token'] ?? ''));
            exit;
        }

        // Get player count
        $conta = $worldDbInstance->fetch("SELECT COUNT(*) as count FROM users")['count'] ?? 0;

        // Calculate farm capacity for header display
        $max_bh = get_village_max_farm($village);

        // Calculate storage capacity
        $max_storage = get_village_max_storage($village);

        // Calculate production per second for JS timer
        global $arr_production;
        global $config;
        $speed = isset($config['speed']) ? $config['speed'] : 1;

        $wood_level = $village['wood'] ?? 0;
        $stone_level = $village['stone'] ?? 0;
        $iron_level = $village['iron'] ?? 0;

        $wm = 1.0;
        $sm = 1.0;
        $im = 1.0;

        if (class_exists('\App\Models\ActiveEffectsModel') && isset($config['db_name'])) {
            $aeModel = new \App\Models\ActiveEffectsModel($config['db_name']);
            $wm = $aeModel->getProductionMultiplier($user['id'], $village['id'], 'wood');
            $sm = $aeModel->getProductionMultiplier($user['id'], $village['id'], 'stone');
            $im = $aeModel->getProductionMultiplier($user['id'], $village['id'], 'iron');
        }

        // Apply village bonus if active
        global $bonus;
        if (isset($bonus->bonusy)) {
            $v_bonus = $village['bonus'] ?? 0;
            if ($v_bonus == 2) {
                $wm += $bonus->bonusy[2]['modifer'] ?? 0.3;
                $sm += $bonus->bonusy[2]['modifer'] ?? 0.3;
                $im += $bonus->bonusy[2]['modifer'] ?? 0.3;
            } elseif ($v_bonus == 3) {
                $wm += $bonus->bonusy[3]['modifer'] ?? 0.5;
            } elseif ($v_bonus == 4) {
                $sm += $bonus->bonusy[4]['modifer'] ?? 0.5;
            } elseif ($v_bonus == 5) {
                $im += $bonus->bonusy[5]['modifer'] ?? 0.5;
            }
        }

        // Apply militia penalty
        $militia_mod = 1.0;
        if (!empty($village['militia_end_time']) && $village['militia_end_time'] > time()) {
            $militia_mod = 0.5;
        }

        // Apply flag modifiers
        $flag_wm = 1.0;
        $flag_sm = 1.0;
        $flag_im = 1.0;
        $flag_type = $village['active_flag_type'] ?? '';
        $flag_level = (int)($village['active_flag_level'] ?? 0);
        if ($flag_type === 'resource_wood') {
            $flag_wm = 1 + ((2 + ($flag_level * 2)) / 100);
        } elseif ($flag_type === 'resource_clay') {
            $flag_sm = 1 + ((2 + ($flag_level * 2)) / 100);
        } elseif ($flag_type === 'resource_iron') {
            $flag_im = 1 + ((2 + ($flag_level * 2)) / 100);
        }

        $wm *= $militia_mod * $flag_wm;
        $sm *= $militia_mod * $flag_sm;
        $im *= $militia_mod * $flag_im;

        $wood_ph = isset($arr_production[$wood_level]) ? $arr_production[$wood_level] : 30;
        $stone_ph = isset($arr_production[$stone_level]) ? $arr_production[$stone_level] : 30;
        $iron_ph = isset($arr_production[$iron_level]) ? $arr_production[$iron_level] : 30;

        $wood_ph *= $speed * $wm;
        $stone_ph *= $speed * $sm;
        $iron_ph *= $speed * $im;

        $wood_s = $wood_ph / 3600;
        $stone_s = $stone_ph / 3600;
        $iron_s = $iron_ph / 3600;

        // Check if user has any premium features active
        // Premium features use expiration timestamps - check if current time is before expiration
        $currentTime = time();
        $premium = false;

        if (
            (!empty($user['account_manager_expires']) && $user['account_manager_expires'] > $currentTime) ||
            (!empty($user['farm_assistant_expires']) && $user['farm_assistant_expires'] > $currentTime) ||
            (!empty($user['wood_production_expires']) && $user['wood_production_expires'] > $currentTime) ||
            (!empty($user['clay_production_expires']) && $user['clay_production_expires'] > $currentTime) ||
            (!empty($user['iron_production_expires']) && $user['iron_production_expires'] > $currentTime)
        ) {
            $premium = true;
        }

        // Get premium points from global account (premium points are global, not world-specific)
        $premium_points = $userGlobal['premium_p'] ?? 0;

        // Count REAL active incoming attacks from movements table (for favicon badge)
        // $user['attacks'] from DB is a historical counter that never resets - we replace it with
        // the live count of attack-type movements targeting this user's villages.
        try {
            $incomingAttacksCount = $worldDbInstance->fetch(
                "SELECT COUNT(*) as cnt
                 FROM movements m
                 JOIN villages v ON m.to_village = v.id
                 WHERE v.userid = ?
                   AND m.type = 'attack'
                   AND m.end_time > ?",
                [$userId, time()]
            );
            $user['attacks'] = $incomingAttacksCount['cnt'] ?? 0;
        } catch (\Exception $e) {
            // On failure, keep the original value but log it
            error_log("Error counting incoming attacks: " . $e->getMessage());
        }

        // Calculate page generation time
        $load_msec = round((microtime(true) - $_SERVER['REQUEST_TIME_FLOAT']) * 1000);

        // Load game view
        echo View::render('game', [

            'user' => $user,
            'village' => $village,
            'user_villages' => $userVillages,
            'screen' => $screen,
            'screenContent' => $screenContent,
            'server' => $server,
            'conta' => $conta,
            'hkey' => $session['hkey'] ?? '',
            'max_bh' => $max_bh,
            'max_storage' => $max_storage,
            'wood_s' => $wood_s,
            'stone_s' => $stone_s,
            'iron_s' => $iron_s,
            'wood_per_hour' => $wood_ph,
            'stone_per_hour' => $stone_ph,
            'iron_per_hour' => $iron_ph,
            'pop_current' => $village['pop'] ?? 0,
            'config' => $config,
            'premium' => $premium,
            'premium_points' => $premium_points,
            'current_locale' => current_locale(),
            'available_locales' => available_locales(),
            'ingame_theme' => $GLOBALS['conf']['ingame_theme'] ?? 'classic',
            'load_msec' => $load_msec
        ]);
    }

    /**
     * Get screen controller class name
     */

<?php

namespace App\Core;

use PDO;
use PDOException;

class Database
{
    private static $instances = [];
    private $pdo;
    private $dbName;

    private function __construct($dbName = null, $dbHost = null, $dbUser = null, $dbPass = null)
    {
        global $conf;
        
        $name = $dbName ?: self::getGlobalDbName();
        
        // AUTO-DETECTION: If dbName is a world database, load its credentials
        if ($dbHost === null && function_exists('get_world_db_config')) {
            $worldsDir = __DIR__ . '/../Config/Worlds/';
            if (is_dir($worldsDir)) {
                foreach (glob($worldsDir . '*.php') as $worldFile) {
                    $worldConfig = @include $worldFile;
                    if (is_array($worldConfig) && isset($worldConfig['db_name']) && $worldConfig['db_name'] === $name) {
                        $dbHost = $worldConfig['db_host'] ?? null;
                        $dbUser = $worldConfig['db_user'] ?? null;
                        $dbPass = $worldConfig['db_pw'] ?? ($worldConfig['db_pass'] ?? null);
                        break;
                    }
                }
            }
        }
        
        $host = $dbHost ?? ($conf['db_host'] ?? 'localhost');
        $user = $dbUser ?? ($conf['db_user'] ?? 'root');
        $pass = $dbPass ?? ($conf['db_pass'] ?? '');
        $charset = 'utf8mb4';

        $this->dbName = $name;

        $dsn = "mysql:host=$host;dbname=$name;charset=$charset";
        $options = [
            PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION,
            PDO::ATTR_DEFAULT_FETCH_MODE => PDO::FETCH_ASSOC,
            PDO::ATTR_EMULATE_PREPARES => false,
        ];

        try {
            $this->pdo = new PDO($dsn, $user, $pass, $options);
            $this->pdo->exec("SET SESSION sql_mode = ''");
        } catch (PDOException $e) {
            throw new PDOException($e->getMessage(), (int) $e->getCode());
        }
    }

    public static function getInstance($dbName = null)
    {
        $key = $dbName ?: 'default';
        if (!isset(self::$instances[$key])) {
            self::$instances[$key] = new self($dbName);
        }
        return self::$instances[$key];
    }

    public function query($sql, $params = [])
    {
        $stmt = $this->pdo->prepare($sql);
        $stmt->execute($params);
        return $stmt;
    }

    public function fetch($sql, $params = [])
    {
        return $this->query($sql, $params)->fetch();
    }

    public function fetchAll($sql, $params = [])
    {
        return $this->query($sql, $params)->fetchAll();
    }

    public function fetchColumn($sql, $params = [])
    {
        return $this->query($sql, $params)->fetchColumn();
    }

    public function lastInsertId()
    {
        return $this->pdo->lastInsertId();
    }

    public function getDatabaseName()
    {
        return $this->dbName;
    }

    /**
     * Returns the global (index) database name from config.
     * This replaces all hardcoded ?? 'index_tw' patterns.
     */
    public static function getGlobalDbName(): string
    {
        global $conf;
        return $conf['db_name'] ?? 'index_tw';
    }

    /**
     * Returns the world database name from session/config.
     * This replaces all hardcoded ?? 'lan_1' patterns.
     * Reads from $_SESSION['world'] (set at login) or falls back to the first world config.
     */
    public static function getWorldDbName(): string
    {
        // 1. World set in session (player is logged in)
        if (!empty($_SESSION['world'])) {
            return $_SESSION['world'];
        }
        // 2. World passed via GET (some AJAX calls)
        if (!empty($_GET['world'])) {
            return $_GET['world'];
        }
        // 3. Fall back to first world config
        $worldsDir = __DIR__ . '/../../Config/Worlds/';
        $worldFiles = glob($worldsDir . '*.php');
        if (!empty($worldFiles)) {
            $worldConf = @include $worldFiles[0];
            if (is_array($worldConf) && !empty($worldConf['db_name'])) {
                return $worldConf['db_name'];
            }
        }
        // 4. Last resort - should never happen on a correctly configured server
        return ($worldConf['db_name']);
    }

    public function getPdo()
    {
        return $this->pdo;
    }

    public function prepare($sql)
    {
        return $this->pdo->prepare($sql);
    }

    public function beginTransaction()
    {
        return $this->pdo->beginTransaction();
    }

    public function commit()
    {
        return $this->pdo->commit();
    }

    public function rollBack()
    {
        return $this->pdo->rollBack();
    }
}
